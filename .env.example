# Application
APP_NAME=Compass SEO AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
# Local/Docker default stores SQLite in ./data (mounted by docker-compose.yml).
# Render can use a persistent disk path such as sqlite:////var/data/compass_seo.db,
# or a managed external database URL if the proper driver is added.
DATABASE_URL=sqlite:///./data/compass_seo.db

# Crawl target
TARGET_DOMAIN=https://compassgrill.co.il
CRAWLER_MAX_PAGES=25
CRAWLER_TIMEOUT_SECONDS=10

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google integrations
# Preferred for Render: paste the complete service account JSON as a single env var value.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GSC_SITE_URL=https://compassgrill.co.il/
GA4_PROPERTY_ID=

# ISTORE read-only integration
ISTORE_BASE_URL=
ISTORE_COMPANY_ID=
ISTORE_X_TOKEN=
ISTORE_TIMEOUT_SECONDS=10

# Optional local alternative to GOOGLE_APPLICATION_CREDENTIALS_JSON.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
